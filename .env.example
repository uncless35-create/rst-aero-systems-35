# Скопируйте в .env и заполните значения.

# --- База данных ---
# Локально (SQLite):
DATABASE_URL="file:./dev.db"
# В проде (Supabase Postgres) — пул для рантайма и прямое подключение для миграций:
# DATABASE_URL="postgresql://...pooler...:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://...:5432/postgres"

# --- Auth.js ---
NEXTAUTH_SECRET="сгенерируйте: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# --- Адрес сайта ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- ЮKassa ---
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# --- СДЭК (расчёт доставки + карта ПВЗ) ---
# Без значений используется ТЕСТОВЫЙ контур СДЭК (api.edu.cdek.ru) с публичными ключами.
# Для боевого режима заполните CDEK_ACCOUNT/CDEK_PASSWORD и смените URL на боевой:
# CDEK_API_URL="https://api.cdek.ru/v2"
# CDEK_ACCOUNT=""
# CDEK_PASSWORD=""
# Код города отправки в системе СДЭК (по умолчанию Москва = 44):
CDEK_FROM_CITY_CODE="44"
# Вес по умолчанию (г) для товаров без указанного веса:
CDEK_DEFAULT_WEIGHT_GRAMS="500"
# Название города отправки для виджета (человекочитаемое):
NEXT_PUBLIC_CDEK_FROM_CITY="Москва"
# Ключ Яндекс.Карт (JavaScript API) — нужен для карты ПВЗ в виджете СДЭК.
# Получить бесплатно: https://developer.tech.yandex.ru → «JavaScript API и HTTP Геокодер».
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=""

# --- СДЭК: отправитель (для кнопки «Создать отправление» в админке) ---
# CDEK_SENDER_NAME="ИП Иванов Иван Иванович"
# CDEK_SENDER_PHONE="+79000000000"
# Код ПВЗ СДЭК, куда сдаёте посылки (shipment_point), напр. NVR2:
# CDEK_SHIPMENT_POINT=""

# --- Telegram-уведомления о заказе (владельцу) ---
# Создать бота: @BotFather → /newbot → токен. chat_id: напишите боту и откройте
# https://api.telegram.org/bot<ТОКЕН>/getUpdates — там chat.id.
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""

# --- Аналитика ---
# Номер счётчика Яндекс.Метрики (только цифры):
# NEXT_PUBLIC_YANDEX_METRICA_ID=""

# --- Supabase Storage (фото товаров) ---
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Администратор (для сида) ---
ADMIN_EMAIL="admin@rst-aero.ru"
ADMIN_PASSWORD="смените-меня"
