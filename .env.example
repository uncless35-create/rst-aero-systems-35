# Скопируйте в .env и заполните значения.

# --- База данных ---
# Локально (SQLite):
DATABASE_URL="file:./dev.db"
# В проде (Supabase Postgres) — пул для рантайма и прямое подключение для миграций:
# DATABASE_URL="postgresql://...pooler...:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://...:5432/postgres"

# --- Auth.js ---
NEXTAUTH_SECRET="сгенерируйте: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# --- Адрес сайта ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- ЮKassa ---
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# --- Supabase Storage (фото товаров) ---
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Администратор (для сида) ---
ADMIN_EMAIL="admin@rst-aero.ru"
ADMIN_PASSWORD="смените-меня"
